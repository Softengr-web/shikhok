# লোকাল ডেমো চালাতে কোনো আসল API key প্রয়োজন নেই।
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shikhok?schema=public"
AUTH_SECRET="change-this-before-production"
PAYMENT_MODE="demo"
VIDEO_MODE="local"
# Optional: enable production classroom NAT traversal with Metered Open Relay.
# Keep the API key server-side; get both values from your Metered dashboard.
METERED_APP_NAME=""
METERED_API_KEY=""
# Optional self-hosted coturn alternative (TURN URLs are comma-separated).
TURN_URLS=""
TURN_SHARED_SECRET=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
EMAIL_MODE="local"
OTP_MODE="demo"
STORAGE_MODE="local"
PORT="3001"
